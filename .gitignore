# ================
# Android Standard
# ================

# built application files
*.apk
*.ap_
*.aab

# ART/Dalvik VM files
*.dex

# Java class files
*.class

# generated files
bin/
gen/
out/

# Gradle build output
build/
**/build/

# Local configuration file (sdk path, keystore path, etc)
local.properties

# Proguard / R8
proguard/
*.log

# Log files
*.log

# ================
# Android Studio / IntelliJ
# ================

# IDE settings
.idea/
*.iml

# Gradle
.gradle/
gradle-app.setting

# Cache
.cxx/
.externalNativeBuild/
captures/

# ================
# OS / Editor files
# ================

# macOS
.DS_Store

# Windows
Thumbs.db

# Linux
*~

# ================
# Keystore files
# ================
# (Never commit signing keys)
*.jks
*.keystore
*.keystore.properties
signing.properties

# ================
# NDK / CMake / JNI
# ================
obj/
*.o

# ================
# Kotlin / Jetpack Compose
# ================
# Kotlin build caches
.kotlinc/

# Compose compiler
compose-metrics/
compose-reports/

# ================
# Other Tools
# ================
# Firebase Crashlytics
crashlytics-build.properties

# IntelliJ caches
.idea/caches
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# Lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/


